# Notion OAuth
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:3000/api/notion/callback

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Encryption (32 bytes hex — run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=

# Database
# Local: file:./garminmd.db
# Docker: file:/app/data/db/garminmd.db (mapped to a volume for persistence)
DATABASE_URL=file:./garminmd.db

# Session (iron-session)
# NEXTAUTH_SECRET must be at least 32 characters long.
NEXTAUTH_SECRET=
# Unused by the app currently, but commonly set for local dev tooling.
NEXTAUTH_URL=http://localhost:3000
